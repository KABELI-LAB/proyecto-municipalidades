{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install)",
      "Bash(npm ls*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx vite*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat */.env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep * .env)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(netlify env:get*)",
      "Bash(netlify env:list*)"
    ]
  }
}
