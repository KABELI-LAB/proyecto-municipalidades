{
  "name": "@muni/cv-empleabilidad",
  "version": "0.1.0",
  "private": true,
  "description": "Pestaña 'Revisa tu CV': sube un CV (PDF/DOCX), recibe feedback y 3 diseños sugeridos.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite-plugin": "./server/vitePlugin.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@muni/design-system": "*",
    "@react-pdf/renderer": "^4.9.0",
    "docx": "^9.8.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
