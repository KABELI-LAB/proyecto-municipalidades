{
  "name": "plataforma-tenencia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "diseno": "node scripts/sincronizar-diseno.mjs",
    "predev": "npm run diseno",
    "dev": "next dev",
    "prebuild": "npm run diseno",
    "build": "next build",
    "start": "next start",
    "db:migrar": "prisma migrate dev",
    "db:generar": "prisma generate",
    "db:migrar-turso": "node --env-file=.env.produccion scripts/migrar-turso.mjs",
    "demo:cargar-produccion": "tsx --env-file=.env.produccion scripts/demo-cargar.ts",
    "demo:borrar": "tsx --env-file=.env scripts/demo-borrar.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "demo:cargar": "tsx --env-file=.env scripts/demo-cargar.ts",
    "publicaciones:vigencia": "tsx --env-file=.env scripts/publicaciones-vigencia.ts",
    "invitaciones:vencer": "tsx --conditions=react-server --env-file=.env scripts/invitaciones-vencer.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^16.3.8",
    "nodemailer": "^7.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
