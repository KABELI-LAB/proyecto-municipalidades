# Copie este archivo como .env y complete los valores.
MUNICIPIO=hualane
DATABASE_URL="file:./prisma/dev.db"
# Publicado (Turso): DATABASE_URL="libsql://…turso.io" y su token aquí. Vacío en desarrollo.
DATABASE_AUTH_TOKEN=""
# Secreto para firmar la sesión del panel. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESION_SECRETO=""
# Contraseña de las cuentas de demostración (demo/datos/usuarios.json).
# Solo para el modo demostración; elija una propia.
DEMO_CONTRASENA=""
# Dirección pública del sitio, para los enlaces del correo semanal.
APP_URL="http://localhost:3000"

# Carpeta privada para las fotos que sube la ciudadanía (por defecto, almacen/ en la raíz del proyecto).
# Debe quedar fuera de public/: las fotos solo se entregan a través del panel, con permiso.
ALMACEN_DIR=
# En Netlify las fotos se guardan solas en Netlify Blobs. Para forzarlo fuera de Netlify: ALMACEN="blobs".
ALMACEN=""
# ── Instagram (opcional) ──
# Publicación con la API oficial de Instagram (Instagram API with Instagram Login).
# Sin estas variables, el panel prepara imágenes y textos para revisar, pero la
# publicación externa queda deshabilitada. Nunca suba estos valores al repositorio
# ni los use en el navegador: solo el servidor los lee.
# Requisitos: cuenta profesional de Instagram de la municipalidad, una aplicación
# de Meta con los permisos instagram_business_basic e instagram_business_content_publish
# (acceso avanzado), y APP_URL con una dirección pública https (Instagram descarga
# la imagen desde el portal).
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Opcionales: versión y servidor de la API (por defecto v25.0 y graph.instagram.com).
INSTAGRAM_API_VERSION=
INSTAGRAM_API_HOST=
# Respuestas automáticas a comentarios y mensajes (opcional). Además requiere los
# permisos instagram_business_manage_comments e instagram_business_manage_messages,
# la app en modo Live y el webhook https://<APP_URL>/api/instagram/webhook con los
# campos comments y messages (vea docs/despliegue-netlify.md).
# App Secret de la app de Meta (Configuración de la app > Básica): valida que el aviso viene de Meta.
INSTAGRAM_APP_SECRET=
# Texto que inventas y escribes igual en el campo «Verify token» del webhook en Meta.
INSTAGRAM_WEBHOOK_TOKEN=
# ── Correo (opcional) ──
# Para enviar las notificaciones y los códigos de acceso a Mis solicitudes.
# Elija UNA opción. Sin ninguna, nada se envía: las notificaciones quedan
# simuladas y, fuera de producción, el código de acceso se muestra en pantalla.
# Nunca suba estos valores al repositorio.
#
# Opción A: casilla institucional por SMTP (Google Workspace: smtp.gmail.com,
# puerto 587 y una «contraseña de aplicación»; Microsoft 365: smtp.office365.com).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
# Opción B: Brevo (plan gratuito de 300 correos al día). Clave de API de Brevo.
BREVO_API_KEY=
# Remitente, por ejemplo: Municipalidad de Hualañé <tenencia@hualane.cl>
# (con Brevo, el remitente debe estar verificado en su cuenta).
CORREO_REMITENTE=
