  SIMULADA
  PENDIENTE
  ENVIADA
  FALLIDA
}

/// Comentario o mensaje recibido en Instagram y la respuesta automática que se le dio.
/// No guarda el nombre de usuario: solo el id que Instagram asigna para responder.
model InteraccionRed {
  id               String   @id @default(cuid())
  municipioId      String
  /// COMENTARIO o MENSAJE.
  canal            String
  /// Id del comentario o del mensaje en Instagram: evita responder dos veces.
  igId             String   @unique
  /// Id de quien escribió (asignado por Instagram para esta cuenta).
  autorIgId        String
  /// Publicación comentada, si es una de las nuestras.
  mediaId          String?
  origenTipo       String?
  origenId         String?
  texto            String
  intencion        String
  respuestaPublica String?
  respuestaPrivada String?
  /// RESPONDIDA, SIN_RESPUESTA (apagado o sin nada que decir) o ERROR.
  estado           String
  error            String?
  creadaEn         DateTime @default(now())

  @@index([municipioId, creadaEn])
}
