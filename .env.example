# Copia este archivo como .env (está en .gitignore) y completa los valores.
# NUNCA subas .env al repositorio ni pegues claves en chats o issues.
# En producción estos valores se configuran en Netlify (Environment variables).

# Endpoint de Azure AI Foundry compatible con OpenAI v1 (termina en /openai/v1)
AZURE_OPENAI_ENDPOINT=https://<su-recurso>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Envío del CV por correo (SMTP). Con Gmail/Google Workspace usa una
# "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcionales: nombre visible del remitente y dirección para respuestas
CV_EMAIL_FROM_NAME=
CV_EMAIL_REPLY_TO=

# Activa los servicios reales en desarrollo (sin esta línea se usan los simulados)
VITE_CV_API_URL=/api
