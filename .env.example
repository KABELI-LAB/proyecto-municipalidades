# Copie este archivo como .env (está en .gitignore) y complete los valores.
# NUNCA suba .env al repositorio ni pegue claves en chats o issues.
# En producción estos valores se configuran en Netlify (Environment variables).

# Endpoint de Azure AI Foundry compatible con OpenAI v1 (termina en /openai/v1)
AZURE_OPENAI_ENDPOINT=https://<su-recurso>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Activa el análisis con IA en desarrollo (sin esta línea se usa el mock)
VITE_CV_API_URL=/api
